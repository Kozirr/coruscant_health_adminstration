#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/backend"

if [ $# -ne 2 ]; then
    echo "Usage: $0 <firstname> <lastname>" >&2
    exit 0
fi

export DATABASE_URL="${DATABASE_URL:-sqlite:///$SCRIPT_DIR/backend/db.sqlite3}"
export DJANGO_SECRET_KEY="${DJANGO_SECRET_KEY:-local-cli-secret-key}"
python3 manage.py health_official "$1" "$2"
